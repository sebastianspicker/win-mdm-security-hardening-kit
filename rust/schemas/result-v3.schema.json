{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResultV3",
  "description": "Strict final execution result emitted by the worker and consumed by reports.",
  "type": "object",
  "properties": {
    "actions": {
      "description": "Individual action outcomes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActionResultV3"
      }
    },
    "artifacts": {
      "description": "Retained artifacts.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactV3"
      }
    },
    "capability_id": {
      "description": "Capability scope for a single-capability result; absent for aggregate profiles.",
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilityId"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "description": "Completion time for the plan execution.",
      "type": "string",
      "format": "date-time"
    },
    "findings": {
      "description": "Findings retained in deterministic action emission order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/FindingV3"
      }
    },
    "host": {
      "description": "Host on which the result was produced.",
      "$ref": "#/$defs/HostIdentityV3"
    },
    "metadata": {
      "description": "Result metadata with no execution semantics.",
      "type": "object",
      "additionalProperties": true
    },
    "operation": {
      "description": "Operation requested for this execution.",
      "$ref": "#/$defs/Operation"
    },
    "plan_id": {
      "description": "Executed plan identity.",
      "$ref": "#/$defs/PlanId"
    },
    "profile_id": {
      "description": "Source profile identity.",
      "$ref": "#/$defs/ProfileId"
    },
    "result_id": {
      "description": "Result identity.",
      "$ref": "#/$defs/ResultId"
    },
    "run_id": {
      "description": "Worker execution identity reserved in the plan.",
      "$ref": "#/$defs/RunId"
    },
    "schema_version": {
      "description": "Version marker for strict decoding.",
      "$ref": "#/$defs/SchemaVersion"
    },
    "started_at": {
      "description": "Start time for the plan execution.",
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "description": "Overall status.",
      "$ref": "#/$defs/ResultStatus"
    },
    "summary": {
      "description": "Human-readable aggregate outcome summary.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "run_id",
    "plan_id",
    "profile_id",
    "operation",
    "host",
    "status",
    "started_at",
    "completed_at",
    "actions",
    "summary"
  ],
  "$defs": {
    "ActionId": {
      "description": "Stable identity of an action in a profile or plan.",
      "type": "string",
      "format": "uuid"
    },
    "ActionResultV3": {
      "description": "The outcome of one planned action.",
      "type": "object",
      "properties": {
        "action_id": {
          "description": "Action identity from the plan.",
          "$ref": "#/$defs/ActionId"
        },
        "capability": {
          "description": "Capability that produced this outcome.",
          "$ref": "#/$defs/CapabilityId"
        },
        "completed_at": {
          "description": "Completion time.",
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "description": "Capability-defined bounded outcome metadata.",
          "type": "object",
          "additionalProperties": true
        },
        "started_at": {
          "description": "Start time.",
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "description": "Terminal action status.",
          "$ref": "#/$defs/ActionStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "action_id",
        "capability",
        "status",
        "started_at",
        "completed_at"
      ]
    },
    "ActionStatus": {
      "description": "Per-action terminal status.",
      "oneOf": [
        {
          "description": "The action completed without non-compliant findings.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "The action completed and recorded non-compliant findings.",
          "type": "string",
          "const": "findings"
        },
        {
          "description": "A declared precondition was not met.",
          "type": "string",
          "const": "blocked"
        },
        {
          "description": "The action was skipped because a dependency did not complete.",
          "type": "string",
          "const": "skipped"
        },
        {
          "description": "The action failed while executing.",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "ArtifactId": {
      "description": "Stable identity of a retained execution artifact.",
      "type": "string",
      "format": "uuid"
    },
    "ArtifactKind": {
      "description": "A deterministic artifact request or produced artifact classification.",
      "oneOf": [
        {
          "description": "A text or structured execution log.",
          "type": "string",
          "const": "log"
        },
        {
          "description": "A report intended for an operator.",
          "type": "string",
          "const": "report"
        },
        {
          "description": "Captured evidence such as a bounded export.",
          "type": "string",
          "const": "evidence"
        },
        {
          "description": "State retained to enable rollback.",
          "type": "string",
          "const": "rollback_state"
        },
        {
          "description": "A capability-specific output file.",
          "type": "string",
          "const": "output"
        }
      ]
    },
    "ArtifactV3": {
      "description": "A requested or retained artifact with integrity information.",
      "type": "object",
      "properties": {
        "created_at": {
          "description": "Time at which the artifact became available.",
          "type": "string",
          "format": "date-time"
        },
        "digest": {
          "description": "Canonical SHA-256 digest of the retained bytes.",
          "$ref": "#/$defs/Sha256Digest"
        },
        "id": {
          "description": "Artifact identifier.",
          "$ref": "#/$defs/ArtifactId"
        },
        "kind": {
          "description": "Artifact category.",
          "$ref": "#/$defs/ArtifactKind"
        },
        "locator": {
          "description": "Worker-controlled, non-secret locator relative to its artifact root.",
          "type": "string"
        },
        "media_type": {
          "description": "MIME type of the retained content.",
          "type": "string"
        },
        "metadata": {
          "description": "Capability-defined, bounded metadata.",
          "type": "object",
          "additionalProperties": true
        },
        "size_bytes": {
          "description": "Number of retained bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "media_type",
        "locator",
        "digest",
        "size_bytes",
        "created_at"
      ]
    },
    "CapabilityId": {
      "description": "A bounded, non-empty capability key (for example `defender.health`).",
      "type": "string"
    },
    "FindingId": {
      "description": "Stable identity of an individual finding.",
      "type": "string",
      "format": "uuid"
    },
    "FindingStatus": {
      "description": "Classification of what a finding means.",
      "oneOf": [
        {
          "description": "Expected state was observed.",
          "type": "string",
          "const": "pass"
        },
        {
          "description": "Expected state was not observed.",
          "type": "string",
          "const": "fail"
        },
        {
          "description": "The state is usable but requires attention.",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Evidence with no pass/fail assertion.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "The check did not run.",
          "type": "string",
          "const": "skipped"
        },
        {
          "description": "The check could not establish state.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "FindingV3": {
      "description": "One capability finding with bounded structured evidence.",
      "type": "object",
      "properties": {
        "action_id": {
          "description": "Action that emitted the finding, when applicable.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "capability": {
          "description": "Capability emitting the finding.",
          "$ref": "#/$defs/CapabilityId"
        },
        "code": {
          "description": "Stable, capability-defined code used for automation.",
          "type": "string"
        },
        "evidence": {
          "description": "Bounded, typed evidence.",
          "type": "object",
          "additionalProperties": true
        },
        "finding_id": {
          "description": "Finding identity.",
          "$ref": "#/$defs/FindingId"
        },
        "message": {
          "description": "Human-readable description.",
          "type": "string"
        },
        "observed_at": {
          "description": "Time the condition was observed.",
          "type": "string",
          "format": "date-time"
        },
        "severity": {
          "description": "Operator-impact severity.",
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "description": "Result classification.",
          "$ref": "#/$defs/FindingStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "finding_id",
        "capability",
        "code",
        "status",
        "severity",
        "message",
        "observed_at"
      ]
    },
    "HostIdentityV3": {
      "description": "Identity information that binds a plan to the intended endpoint.",
      "type": "object",
      "properties": {
        "architecture": {
          "description": "CPU architecture label.",
          "type": "string"
        },
        "boot_id": {
          "description": "Operating-system boot identifier; prevents a plan crossing a reboot boundary.",
          "type": "string"
        },
        "fingerprint": {
          "description": "Canonical digest binding these identity fields.",
          "$ref": "#/$defs/Sha256Digest"
        },
        "host_id": {
          "description": "Stable worker-defined endpoint identifier, not an authentication secret.",
          "type": "string"
        },
        "hostname": {
          "description": "Current computer name for operator display.",
          "type": "string"
        },
        "os_family": {
          "description": "Operating-system family.",
          "$ref": "#/$defs/OsFamily"
        },
        "os_version": {
          "description": "Operating-system version returned by the worker.",
          "type": "string"
        },
        "session_id": {
          "description": "Worker session identifier; prevents replay through another local session.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host_id",
        "boot_id",
        "session_id",
        "hostname",
        "os_family",
        "os_version",
        "architecture",
        "fingerprint"
      ]
    },
    "Operation": {
      "description": "Whether an action is observation-only or can alter the endpoint.",
      "oneOf": [
        {
          "description": "Gather state without applying a desired configuration.",
          "type": "string",
          "const": "audit"
        },
        {
          "description": "Produce a host-bound, expiring plan without changing endpoint state.",
          "type": "string",
          "const": "plan"
        },
        {
          "description": "Apply an already validated plan.",
          "type": "string",
          "const": "apply"
        }
      ]
    },
    "OsFamily": {
      "description": "The Windows or cross-platform operating-system family that a capability supports.",
      "oneOf": [
        {
          "description": "Microsoft Windows.",
          "type": "string",
          "const": "windows"
        },
        {
          "description": "Linux.",
          "type": "string",
          "const": "linux"
        },
        {
          "description": "macOS.",
          "type": "string",
          "const": "macos"
        },
        {
          "description": "An explicitly unsupported or unrecognized platform.",
          "type": "string",
          "const": "other"
        }
      ]
    },
    "PlanId": {
      "description": "Stable identity of a signed planning decision.",
      "type": "string",
      "format": "uuid"
    },
    "ProfileId": {
      "description": "Stable identity of a profile.",
      "type": "string",
      "format": "uuid"
    },
    "ResultId": {
      "description": "Stable identity of one execution result.",
      "type": "string",
      "format": "uuid"
    },
    "ResultStatus": {
      "description": "Overall terminal status of a plan execution.",
      "oneOf": [
        {
          "description": "Execution completed with no drift or warnings.",
          "type": "string",
          "const": "completed"
        },
        {
          "description": "Execution failed to produce a trustworthy completed result.",
          "type": "string",
          "const": "execution_failed"
        },
        {
          "description": "Execution completed but observed warning-level drift.",
          "type": "string",
          "const": "warnings"
        },
        {
          "description": "The requested capability or operation is not supported.",
          "type": "string",
          "const": "unsupported"
        },
        {
          "description": "Input, trust, freshness, or plan verification was rejected.",
          "type": "string",
          "const": "rejected"
        },
        {
          "description": "The operator cancelled before completion.",
          "type": "string",
          "const": "cancelled"
        }
      ]
    },
    "RunId": {
      "description": "Stable identity of one worker execution attempt.",
      "type": "string",
      "format": "uuid"
    },
    "SchemaVersion": {
      "description": "Wire version for every v3 document.",
      "oneOf": [
        {
          "description": "`BaselineOps` v3.0 contract.",
          "type": "string",
          "const": "3.0"
        }
      ]
    },
    "Severity": {
      "description": "Severity for an individual finding.",
      "oneOf": [
        {
          "description": "Informational evidence.",
          "type": "string",
          "const": "info"
        },
        {
          "description": "Low-priority condition.",
          "type": "string",
          "const": "low"
        },
        {
          "description": "Material condition needing normal remediation.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "Security-relevant condition needing prompt attention.",
          "type": "string",
          "const": "high"
        },
        {
          "description": "Emergency security or availability condition.",
          "type": "string",
          "const": "critical"
        }
      ]
    },
    "Sha256Digest": {
      "description": "Lowercase, 32-byte SHA-256 digest used to bind profiles, plans, and evidence.",
      "type": "string"
    }
  }
}
